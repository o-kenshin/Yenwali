# =============================================================================
# Yenwali の環境変数（.env.local にコピーして使う）
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# ローカル: `npx supabase start` / `npx supabase status` に表示される値
# 本番: Supabase のダッシュボード > Project Settings > API Keys

# プロジェクトの URL（ブラウザでも使う: Realtime の購読）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 公開してよいキー（ブラウザで Realtime の Broadcast を購読するためだけに使う）
# RLS で全テーブルを拒否しているので、このキーではデータを読み書きできない
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# サーバー専用のシークレットキー（絶対にクライアントに出さない。NEXT_PUBLIC_ を付けない）
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- 任意 ---------------------------------------------------------------------
# データの保存先: supabase（既定）| memory（Supabase なしで試す・E2E テスト用。Vercel では使えない）
# YENWALI_STORE=memory

# 1 にすると為替 API を叩かず固定のレートを返す（E2E テスト用）
# YENWALI_FAKE_RATES=1
